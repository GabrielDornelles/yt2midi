{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yt2midi",
  "version": "0.1.0",
  "identifier": "dev.yt2midi.desktop",
  "build": {
    "frontendDist": "./stub"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "category": "Music",
    "linux": {
      "deb": {
        "depends": [
          "ffmpeg",
          "libasound2t64 | libasound2"
        ]
      }
    },
    "shortDescription": "YouTube piano videos to MIDI and sheet music",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "longDescription": "Paste a YouTube falling-notes piano video (or drop a video file) and get the MIDI, a practice piano you can slow down, an easy big-dot sheet and standard sheet music. No AI and no cloud: everything is calculated on your computer.",
    "publisher": "Gabriel Dornelles",
    "homepage": "https://github.com/GabrielDornelles/yt2midi",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer/hooks.nsh"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
